# Copy to .env.local and fill in SANDBOX values only. Never commit .env.local.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Multiparty (platform) - from the Developer Dashboard once partner features are set up
PAYPAL_PARTNER_MERCHANT_ID=
# Webhook ID from the PayPal app (sandbox) after registering <APP_URL>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# AI
ANTHROPIC_API_KEY=

# Local dev database
DATABASE_URL=postgres://localhost:5432/cosign_dev

# Owner sign-in (Auth.js + Resend). AUTH_SECRET: openssl rand -base64 33
AUTH_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Cosign <onboarding@resend.dev>"

# Protects scheduled jobs. Generate with: openssl rand -hex 32
JOB_SECRET=

# Public origin of this app, no trailing slash. Every PayPal return/cancel URL,
# email link and redirect is built from it. MUST be set in production (defaults to
# http://localhost:3001 for local dev).
APP_URL=

# Demo procurement bot: Channel3 product search (optional market price check)
CHANNEL3_API_KEY=

# "on" shows "Try the demo" (shared PayPal-sandbox demo account for judges)
DEMO_LOGIN=
